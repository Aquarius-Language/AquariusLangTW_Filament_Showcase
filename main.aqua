# 星泉 × Filament 1.78.0 展示 / AquariusLang × Filament showcase
# 1 夜間街景 Bistro · 2 材質球（停車場）· 3 材質球（石板街）· 4 飛行頭盔 · 5 螢幕空間折射
# Keys: 1-5 / N / P switch scenes, Esc quits. 數字鍵 1-5 或 N/P 切換場景，Esc 離開。
變數 濾 = 匯入("/bottles/Aqua_Filament/main.aqua");
變數 Arrays = 匯入("Array");
變數 字串庫 = 匯入("String");
變數 資產 = 目前工作目錄 + "/assets";

變數 夜景 = 匯入(目前工作目錄 + "/scenes/night_street.aqua");
變數 停車場材質 = 匯入(目前工作目錄 + "/scenes/materials.aqua");
變數 街道材質 = 匯入(目前工作目錄 + "/scenes/materials.aqua");
變數 頭盔 = 匯入(目前工作目錄 + "/scenes/flight_helmet.aqua");
變數 折射 = 匯入(目前工作目錄 + "/scenes/refraction.aqua");
停車場材質.設定("garage");
街道材質.設定("street");
變數 場景列表 = [夜景, 停車場材質, 街道材質, 頭盔, 折射];

變數 目前 = -1;
變數 載入場景 = 函式(索引) {
    如果 (索引 == 目前) { 回傳 目前; }
    濾.清除場景(假);
    變數 場景 = 場景列表[索引];
    印出("▶", 索引 + 1, 場景.名稱, "/", 場景.Name);
    印出("  ", 場景.提示);
    濾.設定標題("星泉 × Filament · " + 場景.名稱 + " · 載入中 Loading…");
    變數 開始 = 目前時間();
    場景.建立(濾, 資產);
    印出("   載入耗時 / loaded in (ms):", 目前時間() - 開始);
    目前 = 索引;
    回傳 目前;
};

變數 資訊 = 濾.開啟視窗({"標題":"星泉 × Filament 1.78.0", "寬度":1600, "高度":900});
印出("Aqua_Filament", 濾.版本, "· Filament", 濾.Filament版本, "·", 濾.平台, "·", 資訊["後端"]);
印出("數字鍵 1-5 / N / P 切換場景，Esc 離開 · Keys 1-5 / N / P switch scenes, Esc quits");
載入場景(0);

變數 標題時間 = 0.0d;
迴圈 (變數 幀號 = 0; 濾.視窗開啟中(); 幀號++) {
    變數 幀 = 濾.繪製畫面();
    如果 (濾.按鍵剛按下("escape")) { 中斷; }
    變數 下一個 = 目前;
    迴圈 (變數 k = 0; k < 長度(場景列表); k++) {
        如果 (濾.按鍵剛按下(["1", "2", "3", "4", "5"][k])) { 下一個 = k; }
    }
    如果 (濾.按鍵剛按下("n")) { 下一個 = (目前 + 1) % 長度(場景列表); }
    如果 (濾.按鍵剛按下("p")) { 下一個 = (目前 + 長度(場景列表) - 1) % 長度(場景列表); }
    如果 (下一個 != 目前) {
        載入場景(下一個);
    } 否則 {
        變數 場景 = 場景列表[目前];
        場景.更新(濾, 幀);
    }
    如果 (幀["時間"] - 標題時間 > 0.5d) {
        標題時間 = 幀["時間"];
        變數 幀率文字 = 字串庫.From(幀["幀率"] + 0.5d);
        變數 點 = 字串庫.Find(幀率文字, ".");
        如果 (點 > 0) { 幀率文字 = 字串庫.Slice(幀率文字, 0, 點); }
        變數 當前場景 = 場景列表[目前];
        濾.設定標題("星泉 × Filament · " + 當前場景.名稱 + " · " + 幀率文字 + " FPS · 1-5 / N / P 切換場景");
    }
}
濾.關閉視窗();
印出("再見 / Bye");
