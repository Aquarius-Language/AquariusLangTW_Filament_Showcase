# 夜間街景 · Amazon Lumberyard Bistro — 77 盞街燈／壁燈／串燈、月光陰影、自發光泛光、環境遮蔽、TAA
# Night street (Bistro exterior): many point & spot lights, moonlight shadows, emissive bloom, SSAO, TAA.
變數 Name = "Night street · Bistro";
變數 名稱 = "夜間街景 · Bistro";
變數 Hint = "WASD/QE fly, drag to look, wheel = speed, B bloom, L lights / WASD QE 飛行、拖曳轉向、L 開關燈";
變數 提示 = Hint;
變數 光源資料 = 匯入(目前工作目錄 + "/../data/bistro_lights.aqua");
變數 模型 = 0;
變數 光源 = [];
變數 燈亮 = 真;
變數 泛光 = 真;
變數 Arrays = 匯入("Array");

變數 Build, 建立 = 函式(濾, 資產) {
    濾.設定天空顏色([0.0015d, 0.002d, 0.005d, 1]);
    濾.載入環境光(資產 + "/environments/studio_small_02/studio_small_02_ibl.ktx", 濾.無值, 1.2d);
    濾.設定曝光值(2.0d);
    濾.設定鏡頭(55, 0.05d, 400);
    # 月光 / moonlight
    濾.加入平行光([0.35d, -0.8d, 0.45d], [0.55d, 0.65d, 1.0d], 1.5d, {"投射陰影":真, "陰影":{"串接層數":4, "貼圖尺寸":2048}});
    變數 資訊 = 濾.載入模型(資產 + "/bistro/bistro.gltf", {"投射陰影":真, "接收陰影":真});
    模型 = 資訊["代碼"];
    光源 = [];
    變數 清單 = 光源資料.光源列表;
    變數 陰影數 = 0;
    迴圈 (變數 i = 0; i < 長度(清單); i++) {
        變數 L = 清單[i];
        如果 (L[0] == "point") {
            Arrays.Append(光源, 濾.加入點光源(L[1], L[2], L[3], L[4], 濾.無值));
        } 否則 {
            變數 陰影 = L[3] >= 10000;
            Arrays.Append(光源, 濾.加入聚光燈(L[1], L[5], L[2], L[3] * 1.6d, 60, L[4] * 1.3d, {"投射陰影":陰影, "陰影":{"貼圖尺寸":512}}));
        }
    }
    濾.設定畫面({"泛光":{"強度":0.22d, "層數":8, "鏡頭光暈":假}, "環境遮蔽":{"半徑":0.4d, "強度":1.0d},
        "時間抗鋸齒":真, "抗鋸齒":"FXAA", "色調映射":"ACES", "陰影類型":"PCF", "暈影":{"中點":0.55d, "羽化":0.6d},
        "霧":{"啟用":真, "距離":12, "密度":0.008d, "顏色":[0.05d, 0.06d, 0.09d], "高度":-2, "高度衰減":0.3d}});
    濾.設定相機([13.0d, 1.9d, -33.0d], [4.0d, 3.2d, -12.0d], [0, 1, 0]);
    濾.飛行控制({"速度":5, "平移速度":0.003d});
    回傳 資訊;
};

變數 Update, 更新 = 函式(濾, 幀) {
    濾.播放動畫(模型, 幀["時間"], 濾.無值);
    如果 (濾.按鍵剛按下("l")) {
        燈亮 = !燈亮;
        迴圈 (變數 i = 0; i < 長度(光源); i++) { 濾.設定光源(光源[i], {"啟用":燈亮}); }
        如果 (燈亮) { 濾.設定模型自發光(模型, 1.0d); } 否則 { 濾.設定模型自發光(模型, 0.0d); }
    }
    如果 (濾.按鍵剛按下("b")) {
        泛光 = !泛光;
        濾.設定畫面({"泛光":{"啟用":泛光, "強度":0.22d, "層數":8}});
    }
    回傳 濾.無值;
};
