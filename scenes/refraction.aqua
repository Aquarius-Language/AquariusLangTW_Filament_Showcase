# 螢幕空間折射 · Suzanne — 實心折射材質（吸收、厚度、折射率）、背景物體透過果凍般的猴頭扭曲
# Screen-space refraction: solid transmissive Suzanne with absorption, thickness and IOR.
變數 Name = "Screen-space refraction · Suzanne";
變數 名稱 = "螢幕空間折射 · Suzanne";
變數 Hint = "Drag to orbit, wheel to zoom, Space pauses, C changes colour / 拖曳旋轉、滾輪縮放、空白鍵暫停、C 換色";
變數 提示 = Hint;
變數 猴頭 = 0;
變數 材質 = 0;
變數 暫停 = 假;
變數 角度 = 0.0d;
變數 色彩 = 0;
變數 色票 = [
    {"基礎色":[1.0d, 0.75d, 0.2d], "吸收":[0.0d, 0.22d, 0.9d]},
    {"基礎色":[0.65d, 1.0d, 0.75d], "吸收":[1.2d, 0.1d, 0.9d]},
    {"基礎色":[0.85d, 0.75d, 1.0d], "吸收":[0.7d, 1.0d, 0.05d]}
];

變數 Build, 建立 = 函式(濾, 資產) {
    變數 環境 = 資產 + "/environments/pillars/pillars";
    濾.載入環境光(環境 + "_ibl.ktx", 環境 + "_skybox.ktx", 30000);
    濾.設定曝光(16, 1.0d / 125, 100);
    濾.設定鏡頭(38, 0.05d, 200);
    濾.加入太陽光([-0.4d, -0.7d, -0.6d], [1, 0.97d, 0.92d], 40000, {"投射陰影":真});
    材質 = 濾.折射材質({"基礎色":[1.0d, 0.75d, 0.2d], "粗糙度":0.04d, "折射率":1.45d, "穿透率":1.0d, "厚度":0.7d,
        "吸收":[0.0d, 0.22d, 0.9d], "清漆":0.8d, "清漆粗糙度":0.02d});
    猴頭 = 濾.載入網格(資產 + "/meshes/monkey.filamesh", 材質, {"位置":[0, 0.15d, 0], "旋轉":[0, -30, 0]});
    # Objects behind Suzanne make the refraction visible.
    變數 藍 = 濾.標準材質({"基礎色":[0.05d, 0.3d, 0.95d, 1], "粗糙度":0.3d});
    變數 紅 = 濾.標準材質({"基礎色":[0.9d, 0.06d, 0.05d, 1], "粗糙度":0.25d, "清漆":1});
    變數 白 = 濾.標準材質({"基礎色":[0.9d, 0.9d, 0.9d, 1], "粗糙度":0.6d});
    濾.加入球體(0.35d, 藍, {"位置":[-0.8d, -0.45d, -1.6d]});
    濾.加入方塊([0.5d, 0.5d, 0.5d], 紅, {"位置":[0.75d, -0.55d, -1.4d], "旋轉":[0, 35, 0]});
    濾.加入圓環(0.45d, 0.12d, 白, {"位置":[0.1d, 0.55d, -2.2d], "旋轉":[70, 0, 0]});
    濾.加入平面(30, 30, 濾.陰影接收材質(0.5d), {"位置":[0, -0.8d, 0], "投射陰影":假});
    濾.設定畫面({"色調映射":"ACES", "螢幕空間折射":真, "環境遮蔽":{"半徑":0.3d}, "泛光":{"強度":0.05d}, "抗鋸齒":"FXAA",
        "時間抗鋸齒":真, "陰影類型":"PCF", "景深":假, "暈影":假, "霧":假});
    濾.設定相機([0, 0.35d, 4.6d], [0, 0.0d, 0], [0, 1, 0]);
    濾.軌道控制({"目標":[0, 0.0d, 0], "縮放速度":0.05d});
    角度 = 0.0d;
    回傳 猴頭;
};

變數 Update, 更新 = 函式(濾, 幀) {
    如果 (濾.按鍵剛按下("space")) { 暫停 = !暫停; }
    如果 (濾.按鍵剛按下("c")) {
        色彩 = (色彩 + 1) % 長度(色票);
        濾.設定材質參數(材質, 色票[色彩]);
    }
    如果 (!暫停) {
        角度 = 角度 + 幀["間隔"] * 20;
        濾.設定旋轉(猴頭, [0, 角度 - 30, 0]);
    }
    回傳 濾.無值;
};
